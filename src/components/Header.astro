<header transition:persist transition:animate="none">
  <nav class="container">
    <a href="/" class="logo">shavkatov.io</a>
    <div class="nav-links">
      <a href="/services/" data-nav="/services/" data-uz="Xizmatlar" data-en="Services">Xizmatlar</a>
      <a href="/blog/" data-nav="/blog/" data-uz="Blog" data-en="Blog">Blog</a>
      <a href="/about/" data-nav="/about/" data-uz="Haqida" data-en="About">Haqida</a>
    </div>
    <div class="nav-right">
      <button class="lang-btn" id="langToggle" aria-label="Switch language">🇺🇿</button>
    </div>
  </nav>
</header>

<script>
  // Header transition:persist bilan saqlanadi — shuning uchun matn va aktiv holat
  // har navigatsiyada astro:page-load orqali qayta hisoblanadi
  const applyHeaderLang = (lang: string) => {
    document.querySelectorAll('.nav-links a').forEach((el) => {
      const e = el as HTMLElement;
      e.textContent = lang === 'en' ? (e.dataset.en || '') : (e.dataset.uz || '');
    });
    const langBtn = document.getElementById('langToggle');
    if (langBtn) langBtn.textContent = lang === 'en' ? '🇬🇧' : '🇺🇿';
  };

  const markActiveNav = () => {
    const path = location.pathname;
    document.querySelectorAll('.nav-links a').forEach((el) => {
      const nav = (el as HTMLElement).dataset.nav!;
      const active = path === nav || path.startsWith(nav);
      if (active) el.setAttribute('aria-current', 'page');
      else el.removeAttribute('aria-current');
    });
  };

  const refreshHeader = () => {
    applyHeaderLang(localStorage.getItem('lang') || 'uz');
    markActiveNav();
  };

  // Barcha eventlar document delegation orqali — persist dublikat muammosini hal qiladi
  if (!(window as any).__headerListenersReady) {
    (window as any).__headerListenersReady = true;

    document.addEventListener('astro:page-load', refreshHeader);

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // Language toggle
      if (target.id === 'langToggle' || target.closest('#langToggle')) {
        const current = localStorage.getItem('lang') || 'uz';
        const next = current === 'en' ? 'uz' : 'en';
        localStorage.setItem('lang', next);
        applyHeaderLang(next);
        document.dispatchEvent(new CustomEvent('langchange', { detail: next }));
      }
    });
  }

  refreshHeader();
</script>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    padding: 1.25rem 0;
    z-index: 50;
    background: #000000;
    backdrop-filter: blur(20px);
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-weight: 500;
    font-size: 1.1rem;
    color: #b3b3b3;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .nav-links a {
    font-size: 0.9rem;
    color: #b3b3b3;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--color-text);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-size: 1.5rem;
    line-height: 1;
    /* Bayroq har doim o'z rangida — grayscale yo'q */
    transition: transform 0.2s ease;
  }

  .lang-btn:hover {
    transform: scale(1.1);
  }

  /* Tor ekranda uchala blok bitta qatorda sig'ishi uchun */
  @media (max-width: 640px) {
    nav {
      padding: 0 1rem;
    }

    .logo {
      font-size: 0.95rem;
    }

    .nav-links {
      gap: 0.75rem;
    }

    .nav-links a {
      font-size: 0.8rem;
    }

    .nav-right {
      gap: 0.6rem;
    }
  }

</style>
