<header transition:persist transition:animate="none">
  <nav class="container">
    <a href="/" class="logo">shavkatov.io</a>
    <div class="nav-links" id="navLinks">
      <a href="/services/" data-nav="/services/" data-uz="Xizmatlar" data-en="Services">Xizmatlar</a>
      <a href="/about/" data-nav="/about/" data-uz="Haqida" data-en="About">Haqida</a>
      <a href="/blog/" data-nav="/blog/" data-uz="Blog" data-en="Blog">Blog</a>
    </div>
    <div class="nav-right">
      <button class="lang-btn" id="langToggle" aria-label="Switch language">🇺🇿</button>
      <button
        class="menu-btn"
        id="menuToggle"
        aria-label="Menyu"
        aria-expanded="false"
        aria-controls="navLinks"
      >
        <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </nav>
</header>

<!-- Xira fon header'dan TASHQARIDA turishi shart: backdrop-filter faqat o'z
     stacking konteksti ortidagini xiralashtiradi, header ichida bo'lsa sahifa
     mazmuniga yetib bormaydi. -->
<div class="nav-scrim" aria-hidden="true"></div>

<script>
  // Header transition:persist bilan saqlanadi — shuning uchun matn va aktiv holat
  // har navigatsiyada astro:page-load orqali qayta hisoblanadi
  const applyHeaderLang = (lang: string) => {
    document.querySelectorAll('.nav-links a').forEach((el) => {
      const e = el as HTMLElement;
      e.textContent = lang === 'en' ? (e.dataset.en || '') : (e.dataset.uz || '');
    });
    const langBtn = document.getElementById('langToggle');
    if (langBtn) langBtn.textContent = lang === 'en' ? '🇬🇧' : '🇺🇿';
  };

  const markActiveNav = () => {
    const path = location.pathname;
    document.querySelectorAll('.nav-links a').forEach((el) => {
      const nav = (el as HTMLElement).dataset.nav!;
      const active = path === nav || path.startsWith(nav);
      if (active) el.setAttribute('aria-current', 'page');
      else el.removeAttribute('aria-current');
    });
  };

  const setMenu = (open: boolean) => {
    const header = document.querySelector('header');
    const btn = document.getElementById('menuToggle');
    if (!header || !btn) return;
    header.classList.toggle('menu-open', open);
    btn.setAttribute('aria-expanded', String(open));
  };

  const refreshHeader = () => {
    applyHeaderLang(localStorage.getItem('lang') || 'uz');
    markActiveNav();
    setMenu(false); // navigatsiyadan keyin menyu yopiq bo'lsin
  };

  // Barcha eventlar document delegation orqali — persist dublikat muammosini hal qiladi
  if (!(window as any).__headerListenersReady) {
    (window as any).__headerListenersReady = true;

    document.addEventListener('astro:page-load', refreshHeader);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setMenu(false);
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // Menyu tugmasi
      if (target.closest('#menuToggle')) {
        const open = document.querySelector('header')?.classList.contains('menu-open');
        setMenu(!open);
        return;
      }

      // Havola, xira fon yoki header tashqarisi bosilsa — yopamiz
      if (target.closest('.nav-links a') || target.closest('.nav-scrim') || !target.closest('header')) {
        setMenu(false);
      }

      // Language toggle
      if (target.id === 'langToggle' || target.closest('#langToggle')) {
        const current = localStorage.getItem('lang') || 'uz';
        const next = current === 'en' ? 'uz' : 'en';
        localStorage.setItem('lang', next);
        applyHeaderLang(next);
        document.dispatchEvent(new CustomEvent('langchange', { detail: next }));
      }
    });
  }

  refreshHeader();
</script>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    padding: 1.25rem 0;
    z-index: 50;
    background: #000000;
    backdrop-filter: blur(20px);
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-weight: 500;
    font-size: 1.1rem;
    color: #b3b3b3;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .nav-links a {
    font-size: 0.9rem;
    color: #b3b3b3;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--color-text);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-size: 1.5rem;
    line-height: 1;
    /* Bayroq har doim o'z rangida — grayscale yo'q */
    transition: transform 0.2s ease;
  }

  .lang-btn:hover {
    transform: scale(1.1);
  }

  /* Menyu ochilganda orqa fon xiralashadi. header ichida turadi, shuning
     uchun uning stacking kontekstidan foydalanadi — nav undan yuqorida qoladi. */
  .nav-scrim {
    position: fixed;
    inset: 0;
    /* header 50 da — panel va logotip xira fondan yuqorida qoladi */
    z-index: 40;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, visibility 0.25s;
  }

  header.menu-open ~ .nav-scrim {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  @media (min-width: 641px) {
    .nav-scrim {
      display: none;
    }
  }

  /* Burger tugmasi — faqat tor ekranda ko'rinadi, bayroqning o'ng tomonida */
  .menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.35rem;
    margin: -0.35rem;
    color: #b3b3b3;
    align-items: center;
    transition: color 0.2s ease;
  }

  .menu-btn:hover {
    color: var(--color-text);
  }

  .menu-icon {
    display: block;
    position: relative;
    width: 18px;
    height: 12px;
  }

  .menu-icon span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.25s ease, opacity 0.15s ease;
  }

  .menu-icon span:nth-child(1) {
    top: 0;
  }

  .menu-icon span:nth-child(2) {
    top: 50%;
    margin-top: -0.75px;
  }

  .menu-icon span:nth-child(3) {
    bottom: 0;
  }

  /* Ochilganda burger X ga aylanadi */
  header.menu-open .menu-icon span:nth-child(1) {
    transform: translateY(5.25px) rotate(45deg);
  }

  header.menu-open .menu-icon span:nth-child(2) {
    opacity: 0;
  }

  header.menu-open .menu-icon span:nth-child(3) {
    transform: translateY(-5.25px) rotate(-45deg);
  }

  /* Tor ekran: nav havolalari ochiladigan panelga aylanadi */
  @media (max-width: 640px) {
    nav {
      padding: 0 1rem;
    }

    .logo {
      font-size: 0.95rem;
    }

    .nav-right {
      gap: 0.85rem;
    }

    .menu-btn {
      display: inline-flex;
    }

    /* Havolalar HTML'da o'z joyida qoladi — faqat panelga ko'chadi */
    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.25rem 1rem 0.6rem;
      text-align: right;
      background: #000000;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    }

    header.menu-open .nav-links {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    /* Desktopdagi 0.95rem dan 50% kattaroq */
    .nav-links a {
      font-size: 1.425rem;
      padding: 0.65rem 0.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .nav-links a:last-child {
      border-bottom: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-icon span,
    .nav-links {
      transition: none;
    }
  }

</style>
