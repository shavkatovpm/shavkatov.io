---
import { ClientRouter, fade } from 'astro:transitions';
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<html lang="uz">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <title>Shavkatov Fayzulloh — SEO, AEO va GEO bo'yicha mutaxassis</title>
  <meta name="description" content="Bizneslarni Google va AI'da topga chiqaraman. SEO, AEO va GEO bo'yicha amaliy maslahat va xizmatlar." />
  <meta name="author" content="Shavkatov Fayzulloh" />
  <link rel="canonical" href="https://shavkatov.io/" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://shavkatov.io/" />
  <meta property="og:title" content="Shavkatov Fayzulloh — SEO, AEO va GEO bo'yicha mutaxassis" />
  <meta property="og:description" content="Bizneslarni Google va AI'da topga chiqaraman." />
  <meta property="og:image" content="https://shavkatov.io/og-image.jpg" />
  <meta property="og:locale" content="uz_UZ" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Shavkatov Fayzulloh — SEO, AEO va GEO bo'yicha mutaxassis" />
  <meta name="twitter:description" content="Bizneslarni Google va AI'da topga chiqaraman." />
  <meta name="twitter:image" content="https://shavkatov.io/og-image.jpg" />

  <meta name="theme-color" content="#000000" />
  <meta name="color-scheme" content="dark" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!--
    Caveat faqat "Shavkatov Fayzulloh" satri uchun ishlatiladi — text= bilan
    shu harflargagina qisqartiramiz (to'liq shrift 73 KB edi).
    Poppins'dan faqat 300 og'irlik kerak (tagline).
  -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400&text=Shavkatov%20Fayzulloh&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400&text=Shavkatov%20Fayzulloh&display=swap" media="print" onload="this.media='all'" />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400&text=Shavkatov%20Fayzulloh&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300&display=swap" />
  </noscript>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Shavkatov Fayzulloh",
      "additionalName": "Furqat o'g'li",
      "jobTitle": "SEO, AEO & GEO Specialist",
      "description": "SEO, AEO and GEO specialist helping SMBs grow through search. Founder of Darslinker.uz. 3+ years of project management experience in IT and marketing.",
      "url": "https://shavkatov.io",
      "image": "https://shavkatov.io/og-image.jpg",
      "knowsAbout": [
        "Search Engine Optimization",
        "Answer Engine Optimization",
        "Generative Engine Optimization",
        "Project Management",
        "Digital Marketing"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Tashkent",
        "addressCountry": "UZ"
      },
      "worksFor": {
        "@type": "Organization",
        "name": "Darslinker",
        "url": "https://darslinker.uz"
      },
      "sameAs": [
        "https://www.linkedin.com/in/fayzulloh-shavkatov-7a60b3367/",
        "https://t.me/shavkatov_ff",
        "https://instagram.com/shavkatov.io"
      ]
    }
  </script>
  <!-- Microsoft Clarity (deferred until after load) -->
  <script type="text/javascript">
    (function () {
      function loadClarity() {
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "vf4tq5adhl");
      }
      function schedule() {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(loadClarity, { timeout: 3000 });
        } else {
          setTimeout(loadClarity, 1500);
        }
      }
      if (document.readyState === 'complete') schedule();
      else window.addEventListener('load', schedule, { once: true });
    })();
  </script>
  <ClientRouter />
</head>
<body class="hero-page">
  <canvas id="splashCanvas"></canvas>
  <Header />
  <section class="hero" transition:animate={fade({ duration: '0.4s' })}>
    <div class="hero-content container">
      <p class="hero-tagline" id="heroTagline"><span class="tag-line1" id="taglineLine1">Bizneslarni Google va AI'da</span> <span class="tag-line2" id="taglineLine2">top 10-talikka chiqaraman</span></p>
      <h1 class="hero-name" id="heroName">Shavkatov Fayzulloh</h1>
      <div class="hero-links" id="heroLinks">
        <a
          href="https://www.linkedin.com/in/fayzulloh-shavkatov-7a60b3367/"
          target="_blank"
          rel="me noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg width="33" height="33" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
        <a
          href="https://t.me/shavkatov_ff"
          target="_blank"
          rel="me noopener noreferrer"
          aria-label="Telegram"
        >
          <svg width="33" height="33" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21.2 4.4L2.4 10.9c-.6.2-.6.7 0 .9l4.8 1.5 1.8 5.8c.2.5.7.5.9.2l2.6-2.7 5.1 3.8c.5.4 1 .2 1.1-.4L22.3 5.3c.2-.7-.4-1.2-1.1-.9z"/>
            <path d="M9.2 13.3l8.4-6.2"/>
          </svg>
        </a>
        <a
          href="https://instagram.com/shavkatov.io"
          target="_blank"
          rel="me noopener noreferrer"
          aria-label="Instagram"
        >
          <svg width="33" height="33" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <defs>
              <linearGradient id="ig-gradient" gradientUnits="userSpaceOnUse" x1="2" y1="22" x2="22" y2="2">
                <stop offset="0%" stop-color="#F58529"/>
                <stop offset="35%" stop-color="#DD2A7B"/>
                <stop offset="70%" stop-color="#8134AF"/>
                <stop offset="100%" stop-color="#515BD4"/>
              </linearGradient>
            </defs>
            <rect x="2" y="2" width="20" height="20" rx="5"/>
            <circle cx="12" cy="12" r="5"/>
            <circle class="ig-dot" cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</body>
</html>

<script>
  import { onLang } from '../scripts/lang';

  // Ichki sahifadan qaytganda kirish animatsiyasi qayta o'ynamasin.
  // astro:before-swap DOM almashishidan OLDIN ishlaydi — shu sababli
  // klass yangi hujjatga paint'dan avval qo'yiladi, miltillash bo'lmaydi.
  document.addEventListener('astro:before-swap', (e) => {
    (e as any).newDocument.body.classList.add('no-intro');
  });

  function setup() {
    // Faqat bosh sahifada ishlaydi
    const heroName = document.getElementById('heroName');
    if (!heroName) return;

    const canvas = document.getElementById('splashCanvas') as HTMLCanvasElement;
    const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (canvas && hasFinePointer && !prefersReducedMotion) {
      const idleInit = () => {
        import('../scripts/splash-cursor.js').then(({ initSplashCursor }) => {
          initSplashCursor(canvas);
        });
      };
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(idleInit, { timeout: 2000 });
      } else {
        setTimeout(idleInit, 500);
      }
    } else if (canvas) {
      canvas.style.display = 'none';
    }

    // Ko'rinish endi butunlay CSS zimmasida — JS hech narsani ko'rsatmaydi,
    // shuning uchun birinchi paint skript yuklanishini kutmaydi.
  }

  onLang((lang) => {
    const line1 = document.getElementById('taglineLine1');
    const line2 = document.getElementById('taglineLine2');
    if (line1 && line2) {
      line1.textContent = lang === 'en' ? 'I get businesses into top 10' : "Bizneslarni Google va AI'da";
      line2.textContent = lang === 'en' ? 'on Google and AI' : 'top 10-talikka chiqaraman';
    }
  });

  // astro:page-load har safar ishlaydi — ham birinchi yuklashda, ham View Transition keyin
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  #splashCanvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .hero-page {
    margin: 0;
    overflow: hidden;
    position: fixed;
    inset: 0;
  }

  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 60px;
    left: 0;
    right: 0;
    bottom: 0;
    padding-bottom: 30vh;
  }

  .hero-content {
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .hero-tagline {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    font-weight: 300;
    color: #b3b3b3;
    margin: 0 auto 2.5rem;
    line-height: 1.5;
    letter-spacing: 0.01em;
    white-space: nowrap;
    animation: heroIn 0.25s ease-out both;
  }

  @media (max-width: 640px) {
    .hero-tagline {
      white-space: normal;
    }

    .hero-tagline .tag-line2 {
      display: block;
    }
  }

  .hero-name {
    font-family: 'Caveat', cursive;
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 400;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
    white-space: nowrap;
    color: #b3b3b3;
    animation: heroIn 0.25s ease-out both;
  }

  .hero-links {
    display: flex;
    gap: 1.75rem;
    justify-content: center;
    align-items: center;
    animation: heroIn 0.25s ease-out both;
  }

  .hero-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Barmoq uchun kattaroq bosish maydoni, ikonka o'lchamiga tegmaydi */
    padding: 0.5rem;
    margin: -0.5rem;
    color: #b3b3b3;
    transition: color 0.2s ease;
  }

  /* Hover'da har biri o'z brend rangiga kiradi — joyidan qimirlamaydi */
  .hero-links a[aria-label='LinkedIn']:hover {
    color: #0a66c2;
  }

  .hero-links a[aria-label='Telegram']:hover {
    color: #29a9eb;
  }

  /* Instagram brendi gradient — stroke'ni SVG gradientga ulaymiz */
  .hero-links a[aria-label='Instagram']:hover svg {
    stroke: url(#ig-gradient);
  }

  .hero-links a[aria-label='Instagram']:hover .ig-dot {
    fill: url(#ig-gradient);
  }

  /* Kirish animatsiyasi — JS'siz, birinchi paint darhol bo'ladi */
  @keyframes heroIn {
    from {
      filter: blur(8px);
    }
    to {
      filter: blur(0px);
    }
  }

  /* Ichki sahifadan qaytganda animatsiya takrorlanmaydi */
  :global(body.no-intro) .hero-tagline,
  :global(body.no-intro) .hero-name,
  :global(body.no-intro) .hero-links {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-tagline,
    .hero-name,
    .hero-links {
      animation: none;
    }
  }

</style>
